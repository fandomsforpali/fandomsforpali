---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import BannerCard from '../components/common/BannerCard.astro';
import Button from '../components/common/Button.astro';
import ButtonList from '../components/common/ButtonList.astro';
import DottedDivider from '../components/common/DottedDivider.astro';
import { siteConfig } from '../data/siteConfig';

const { campaign } = siteConfig;
---

<Layout title={campaign.title} description={campaign.description}>
  <div class="w-full max-w-[56rem] flex flex-col items-center text-center px-4">
    <!-- Campaign Header -->
    <SectionHeader
      pretitle="- Current Campaign -"
      title={campaign.title}
      subtitle={campaign.subtitle}
      level={1}
    />

    <p class="text-cream text-base md:text-lg max-w-2xl my-4 drop-shadow-carrd-subheading">
      {campaign.description}
    </p>

    <!-- Top Action CTA Buttons -->
    <ButtonList direction="row" gap="sm" class="my-4">
      <li>
        <Button href={campaign.leadAppUrl} variant="nav" color="cyan" external={true}>
          Apply for Leads
        </Button>
      </li>
      <li>
        <Button href={campaign.directorAppUrl} variant="nav" color="orange" external={true}>
          Apply for Directors
        </Button>
      </li>
      <li>
        <Button href={campaign.donationLink} variant="nav" color="crimson" external={true}>
          Donate to Mohammed
        </Button>
      </li>
    </ButtonList>

    <DottedDivider />

    <!-- Applications Open Banner Highlight -->
    <div class="w-full my-6 flex flex-col items-center">
      <SectionHeader title="Applications Open: Leads & Directors" level={2} />
      <div class="max-w-[28rem] w-full my-4">
        <BannerCard
          src={campaign.image}
          alt="Lead & Director Applications - JacksonBug Campaign"
          rounded="2xl"
        />
      </div>

      <p class="text-cream/90 text-sm sm:text-base max-w-xl my-2">
        {campaign.rolesOverview}
      </p>

      <!-- Roles Details Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full my-6 text-left">
        <div class="rounded-carrd-card bg-card-bg border border-card-border p-6 shadow-carrd-btn flex flex-col justify-between">
          <div>
            <div class="mb-2">
              <h3 class="text-xl font-bold text-ffp-orange">Directors</h3>
            </div>
            <p class="text-sm text-cream/85 leading-relaxed">
              Directors guide the high-level vision of the campaign. Responsibilities include setting milestones, managing overall event schedules, overseeing department coordination, and liaising with humanitarian partners and the core FFP leadership team.
            </p>
          </div>
          <div class="mt-6">
            <Button href={campaign.directorAppUrl} variant="nav" color="orange" external={true} class="w-full">
              Submit Director Application &rarr;
            </Button>
          </div>
        </div>

        <div class="rounded-carrd-card bg-card-bg border border-card-border p-6 shadow-carrd-btn flex flex-col justify-between">
          <div>
            <div class="mb-2">
              <h3 class="text-xl font-bold text-ffp-cyan">Department Leads</h3>
            </div>
            <p class="text-sm text-cream/85 leading-relaxed">
              Leads manage focused creative and operational departments: Art Leads, Writing Leads, Communications/Social Media Leads, and Logistics Leads. They coordinate creator check-ins, curate assets, and ensure our community deliverables run smoothly.
            </p>
          </div>
          <div class="mt-6">
            <Button href={campaign.leadAppUrl} variant="nav" color="cyan" external={true} class="w-full">
              Submit Lead Application &rarr;
            </Button>
          </div>
        </div>
      </div>
    </div>

    <DottedDivider />

    <!-- Campaign Comic Strip Section -->
    <section class="w-full my-6 flex flex-col items-center">
      <SectionHeader
        pretitle="- Campaign Storyline -"
        title="The Next Chapter: FFP Multiverse Comic"
        subtitle="Art by Shay — Ahsan & Laaiqah unite fandoms for Palestine"
        level={2}
      />

      <p class="text-cream/90 text-sm sm:text-base max-w-2xl my-3">
        Follow our Palestinian heroes Ahsan (Gaza) and Laaiqah (Jenin) as they step through multiversal portals into the world of Percy Jackson and Camp Half-Blood to call on fans worldwide to unite for Palestine.
      </p>

      <div class="w-full max-w-[36rem] flex flex-col gap-6 my-6">
        {
          campaign.comicPanels.map((panel, idx) => (
            <figure class="w-full rounded-2xl overflow-hidden bg-card-bg border border-card-border shadow-carrd-btn p-3">
              <img
                src={panel.src}
                alt={panel.alt}
                class="w-full h-auto rounded-xl object-contain"
                loading="lazy"
              />
              {panel.caption && (
                <figcaption class="mt-3 text-xs sm:text-sm text-cream/80 italic text-center px-2">
                  {panel.caption}
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>

      <div class="flex flex-wrap gap-3 justify-center my-4">
        <Button href={campaign.leadAppUrl} variant="nav" color="cyan" external={true}>
          Apply for Leads
        </Button>
        <Button href={campaign.directorAppUrl} variant="nav" color="orange" external={true}>
          Apply for Directors
        </Button>
      </div>
    </section>

    <DottedDivider />

    <!-- DTIYS Artwork Countdown Gallery -->
    <section class="w-full my-6 flex flex-col items-center">
      <SectionHeader
        pretitle="- Community Art -"
        title="Draw This In Your Style (DTIYS)"
        subtitle="Countdown art from our campaign community"
        level={2}
      />

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full my-6">
        {
          campaign.dtiysImages.map((img) => (
            <div class="rounded-xl overflow-hidden bg-card-bg border border-card-border shadow-carrd-btn transition-transform duration-250 hover:scale-105">
              <img
                src={img.src}
                alt={img.alt}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </section>

    <DottedDivider />

    <!-- Back to Home Button -->
    <div class="my-6">
      <Button href="/" variant="nav" color="plum">
        &larr; Back to Home
      </Button>
    </div>
  </div>
</Layout>
