---
export interface Props {
  class?: string;
}

const { class: customClass = '' } = Astro.props;
---

<div
  class={`w-full max-w-[57rem] grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center md:items-start ${customClass}`}
>
  <div class="w-full flex flex-col items-center text-center">
    <slot name="left" />
  </div>
  <div class="w-full flex flex-col items-center text-center">
    <slot name="right" />
  </div>
</div>

