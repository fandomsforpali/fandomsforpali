---
export interface Props {
  pretitle?: string;
  title: string;
  subtitle?: string;
  level?: 1 | 2 | 3;
  align?: 'center' | 'left' | 'right';
  class?: string;
}

const {
  pretitle,
  title,
  subtitle,
  level = 2,
  align = 'center',
  class: customClass = '',
} = Astro.props;

const alignClasses: Record<string, string> = {
  center: 'text-center items-center',
  left: 'text-left items-start',
  right: 'text-right items-end',
};

const Tag = level === 1 ? 'h1' : level === 2 ? 'h2' : 'h3';
---

<header class={`flex flex-col ${alignClasses[align]} my-3 ${customClass}`}>
  {
    pretitle && (
      <span class="text-cream text-[1rem] font-semibold tracking-wide drop-shadow-carrd-subheading uppercase mb-0.5 select-none">
        {pretitle}
      </span>
    )
  }
  <Tag
    class="text-cream font-extrabold tracking-tight drop-shadow-carrd-heading leading-tight text-[1.5rem] md:text-[1.75rem]"
  >
    {title}
  </Tag>
  {
    subtitle && (
      <p class="text-cream/90 text-[1rem] font-medium mt-1 drop-shadow-carrd-subheading max-w-xl">
        {subtitle}
      </p>
    )
  }
</header>

