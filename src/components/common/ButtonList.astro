---
export interface Props {
  direction?: 'col' | 'row';
  gap?: 'sm' | 'md' | 'lg';
  class?: string;
  align?: 'center' | 'start' | 'end';
}

const {
  direction = 'col',
  gap = 'md',
  align = 'center',
  class: customClass = '',
} = Astro.props;

const gapClasses: Record<string, string> = {
  sm: 'gap-2.5',
  md: 'gap-6',
  lg: 'gap-8',
};

const directionClasses: Record<string, string> = {
  col: 'flex-col',
  row: 'flex-row flex-wrap',
};

const alignClasses: Record<string, string> = {
  center: 'items-center justify-center text-center',
  start: 'items-start justify-start text-left',
  end: 'items-end justify-end text-right',
};
---

<ul
  class={`flex w-full ${directionClasses[direction]} ${gapClasses[gap]} ${alignClasses[align]} list-none p-0 m-0 ${customClass}`}
>
  <slot />
</ul>

